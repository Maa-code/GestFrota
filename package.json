{
  "name": "gestfrota-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Gestão de Combustível e Frota Municipal (GestFrota)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @gestfrota/api run test && node infra/scripts/run-db-tests.js",
    "lint": "pnpm -r run lint",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:wait": "node infra/scripts/wait-for-db.js",
    "db:migrate": "node infra/scripts/migrate.js",
    "db:test": "node infra/scripts/run-db-tests.js"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "typescript": "^5.8.0"
  }
}
